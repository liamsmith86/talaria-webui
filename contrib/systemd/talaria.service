# Optional user unit: ~/.config/systemd/user/talaria.service
# Install Talaria first; use --service talaria.service --scope user when
# initializing a deployment that will be managed by this existing unit.
[Unit]
Description=Talaria web client for Hermes
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/talaria/current
ExecStart=%h/.local/share/talaria/current/venv/bin/talaria
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
UMask=0077
MemoryMax=384M
TasksMax=128

[Install]
WantedBy=default.target
