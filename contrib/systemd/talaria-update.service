# Optional user unit. Not enabled by Talaria itself.
# For checks only, append --check to ExecStart.
[Unit]
Description=Update Talaria from its configured Git branch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/share/talaria/bin/talaria update
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=20min
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0022
